# Google OAuth2 credentials (Google Cloud Console > APIs & Services > Credentials,
# "Desktop app" client, with the Gmail API enabled on the project)
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# One-time: set -a; source .env; set +a; go run ./cmd/authorize
REFRESH_TOKEN=your-refresh-token

# Where the email lands. Comma-separate for more than one recipient:
# MAIL_TO=you@example.com,someone@example.com
MAIL_TO=you@example.com

# exchangerate-api.com key (https://app.exchangerate-api.com)
EXCHANGERATE_API_KEY=your-exchangerate-api-key

# Rate history, used for "% change since the previous publication".
# On Lambda: the S3 bucket holding history.json. Locally: leave unset and it uses
# HISTORY_FILE (default ./history.json).
# HISTORY_BUCKET=your-bucket-name
# HISTORY_FILE=history.json

# Not used by phase 1 (no LLM). Reserved for phase 2.
OPENAI_API_KEY=your-llm-api-key
model=your-llm-model
