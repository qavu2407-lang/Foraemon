# Google OAuth2 credentials (Google Cloud Console > APIs & Services > Credentials,
# "Desktop app" client, with the Gmail API enabled on the project)
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# One-time: set -a; source .env; set +a; go run ./cmd/authorize
REFRESH_TOKEN=your-refresh-token

# Where the alerts land
MAIL_TO=you@example.com

# exchangerate-api.com key (https://app.exchangerate-api.com)
EXCHANGERATE_API_KEY=your-apilayer-key

# LLM API key. Here I use OpenAI API key
LLM_API_KEY=your-llm-api-key